# Never ship secrets, caches, or locally generated artifacts into the build context.

# Dependencies
node_modules
**/node_modules

# VCS
.git
.gitignore

# Local env files (secrets!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
!**/.env.example

# Turbo / tooling caches
.turbo
**/.turbo

# Build outputs
.next
**/.next
dist
build
out
coverage

# Locally generated Prisma client (regenerated inside the image)
packages/db/generated
**/generated

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.vscode
.idea
.DS_Store
