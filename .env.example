# Copy this file to .env and fill in the values.
# Compose reads .env automatically for variable interpolation:
#   cp .env.example .env
#   docker compose up -d --build

# --- Infra (defaults match the compose services) ---
POSTGRES_USER=repolyzer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=repolyzer
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=3000

# --- Required: compose refuses to start without it ---
OPENROUTER_API_KEY=sk-or-...

# --- Optional ---
GITHUB_TOKEN=ghp_...
CORS_ORIGIN=http://localhost:3001
PYTHON_BIN=python3
