// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum RepoStatus {
  QUEUED
  CLONING
  PARSING
  SUMMARY
  CHUNKING
  EMBEDDING
  COMPLETED
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum ArtifactType {
  ARCHITECTURE
  DOCUMENTATION
  README
  API_DOCS
  FOLDER_GUIDE
  NOTEBOOK
  CODE_REVIEW
  SYSTEM_ARCHITECTURE
}

model Repository {
  id              String     @id @default(cuid())

  githubUrl       String
  cloneUrl        String

  owner           String
  name            String

  description     String?
  defaultBranch   String?
  latestCommitSha String?

  language        String?

  stars           Int        @default(0)
  forks           Int        @default(0)

  status          RepoStatus @default(QUEUED)
  indexedAt       DateTime?

  files           File[]
  jobs            Job[]
  chats           Chat[]
  githubIssues    GithubIssue[]
  artifacts       AiArtifact[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([owner, name])
}

model Job {
  id            String    @id @default(cuid())

  repositoryId  String
  repository    Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  status        JobStatus @default(PENDING)

  startedAt     DateTime?
  completedAt   DateTime?

  error         String?

  createdAt     DateTime @default(now())

  @@index([repositoryId])
}

model File {
  id            String @id @default(cuid())

  repositoryId  String
  repository    Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  path          String
  extension     String?
  language      String?

  size          Int
  hash          String

  summary       String?

  chunks        Chunk[]

  createdAt     DateTime @default(now())

  @@index([repositoryId])
}

model Chunk {
  id            String  @id @default(cuid())

  repositoryId  String

  fileId        String
  file          File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  chunkIndex    Int

  content       String

  tokenCount    Int?

  embedding     Unsupported("vector(1536)")?

  vectorId      String?

  createdAt     DateTime @default(now())

  @@index([repositoryId])
  @@index([fileId])
}

model GithubIssue {
  id              String   @id @default(cuid())

  repositoryId    String
  repository      Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  issueNumber     Int
  title           String
  body            String?
  labels          Json?
  author          String
  state           String   @default("open")
  commentsCount   Int      @default(0)
  url             String
  githubCreatedAt DateTime
  githubUpdatedAt DateTime

  createdAt       DateTime @default(now())

  @@unique([repositoryId, issueNumber])
  @@index([repositoryId])
}

model Chat {
  id            String @id @default(cuid())

  repositoryId  String
  repository    Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  title         String?

  messages      Message[]

  createdAt     DateTime @default(now())

  @@index([repositoryId])
}

model Message {
  id          String @id @default(cuid())

  chatId      String
  chat        Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  role        MessageRole

  content     String

  createdAt   DateTime @default(now())

  @@index([chatId])
}

model AiArtifact {
  id            String @id @default(cuid())

  repositoryId  String
  repository    Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  type          ArtifactType

  content       String

  createdAt     DateTime @default(now())

  @@index([repositoryId])
  @@index([type])
}